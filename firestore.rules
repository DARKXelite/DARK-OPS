rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function hasRole(allowed) {
      return signedIn()
        && exists(/databases/$(database)/documents/app_roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/app_roles/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/app_roles/$(request.auth.uid)).data.role in allowed;
    }
    function admin() { return hasRole(['admin']); }
    function manager() { return hasRole(['admin', 'manager']); }
    function storeTeam() { return hasRole(['admin', 'manager', 'storekeeper']); }
    function opsTeam() { return hasRole(['admin', 'manager', 'operator']); }
    function fnbTeam() { return hasRole(['admin', 'manager', 'storekeeper']); }

    function validFnbOrderCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'itemName', 'category', 'supplier', 'orderDate', 'orderedQty', 'receivedQty',
          'unit', 'expectedRate', 'notes', 'status', 'createdAt', 'updatedAt',
          'importSource', 'sourceFile', 'sourceRow'
        ])
        && d.keys().hasAll([
          'itemName', 'category', 'supplier', 'orderDate', 'orderedQty', 'receivedQty',
          'unit', 'expectedRate', 'notes', 'status', 'createdAt', 'updatedAt'
        ])
        && d.itemName is string && d.itemName.size() > 0 && d.itemName.size() <= 200
        && d.category is string && d.category.size() <= 100
        && d.supplier is string && d.supplier.size() > 0 && d.supplier.size() <= 200
        && d.orderDate is string && d.orderDate.size() == 10
        && d.orderedQty is number && d.orderedQty > 0
        && d.receivedQty is number && d.receivedQty == 0
        && d.unit is string && d.unit.size() > 0 && d.unit.size() <= 30
        && d.expectedRate is number && d.expectedRate >= 0
        && d.notes is string && d.notes.size() <= 1000
        && d.status == 'Pending'
        && d.createdAt == request.time && d.updatedAt == request.time
        && (!d.keys().hasAny(['importSource']) || d.importSource == 'file')
        && (!d.keys().hasAny(['sourceFile']) || (d.sourceFile is string && d.sourceFile.size() <= 255))
        && (!d.keys().hasAny(['sourceRow']) || (d.sourceRow is number && d.sourceRow >= 0));
    }

    function validFnbReceiptOrderUpdate(id) {
      let d = request.resource.data;
      let old = resource.data;
      let receiptPath = /databases/$(database)/documents/fnb_receipts/$(d.lastReceiptId);
      let quantityDelta = d.receivedQty - old.receivedQty;
      return d.diff(old).affectedKeys().hasOnly(['receivedQty', 'status', 'updatedAt', 'lastReceiptId'])
        && d.orderedQty is number && old.orderedQty is number
        && d.orderedQty == old.orderedQty
        && d.receivedQty is number && old.receivedQty is number
        && d.receivedQty > old.receivedQty
        && d.lastReceiptId is string && d.lastReceiptId.size() > 0
        // Receipt and order balance must be posted in the same transaction.
        && existsAfter(receiptPath)
        && getAfter(receiptPath).data.orderId == id
        && getAfter(receiptPath).data.quantity is number
        && quantityDelta > getAfter(receiptPath).data.quantity - 0.000001
        && quantityDelta < getAfter(receiptPath).data.quantity + 0.000001
        // Tiny tolerance accommodates IEEE-754 decimal arithmetic, not meaningful over-receipt.
        && d.receivedQty <= d.orderedQty + 0.000001
        && d.updatedAt == request.time
        && ((d.receivedQty > 0 && d.receivedQty < d.orderedQty && d.status == 'Partial')
          || (d.receivedQty >= d.orderedQty && d.receivedQty <= d.orderedQty + 0.000001 && d.status == 'Received'));
    }

    function validNormalInwardCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'itemId', 'itemName', 'category', 'unit', 'quantity', 'rate', 'gstPercent',
          'taxableAmount', 'gstAmount', 'total', 'supplier', 'invoiceNumber',
          'receiptDate', 'notes', 'createdAt', 'transactionType'
        ])
        && d.keys().hasAll([
          'itemId', 'itemName', 'category', 'unit', 'quantity', 'rate', 'gstPercent',
          'taxableAmount', 'gstAmount', 'total', 'supplier', 'invoiceNumber',
          'receiptDate', 'notes', 'createdAt', 'transactionType'
        ])
        && d.transactionType == 'INWARD'
        && d.itemId is string && d.itemId.size() > 0
        && d.itemName is string && d.itemName.size() > 0 && d.itemName.size() <= 200
        && d.category is string && d.category.size() <= 100
        && d.unit is string && d.unit.size() > 0 && d.unit.size() <= 30
        && d.quantity is number && d.quantity > 0
        && d.rate is number && d.rate >= 0
        && d.gstPercent is number && d.gstPercent >= 0 && d.gstPercent <= 100
        && d.taxableAmount is number && d.taxableAmount >= 0
        && d.gstAmount is number && d.gstAmount >= 0
        && d.total is number && d.total >= 0
        && d.supplier is string && d.supplier.size() <= 200
        && d.invoiceNumber is string && d.invoiceNumber.size() <= 100
        && d.receiptDate is string && d.receiptDate.size() == 10
        && d.notes is string && d.notes.size() <= 1000
        && d.createdAt == request.time;
    }

    function validFnbInwardCreate(id) {
      let d = request.resource.data;
      let receiptPath = /databases/$(database)/documents/fnb_receipts/$(d.fnbReceiptId);
      return d.transactionType == 'FNB_RECEIPT'
        && d.keys().hasOnly([
          'itemId', 'itemName', 'category', 'fnbCategory', 'unit', 'quantity', 'rate',
          'gstPercent', 'taxableAmount', 'gstAmount', 'total', 'supplier', 'invoiceNumber',
          'receiptDate', 'notes', 'transactionType', 'fnbOrderId', 'fnbReceiptId', 'createdAt'
        ])
        && d.keys().hasAll([
          'itemId', 'itemName', 'category', 'fnbCategory', 'unit', 'quantity', 'rate',
          'gstPercent', 'taxableAmount', 'gstAmount', 'total', 'supplier', 'invoiceNumber',
          'receiptDate', 'notes', 'transactionType', 'fnbOrderId', 'fnbReceiptId', 'createdAt'
        ])
        && d.itemId is string && d.itemId.size() > 0
        && d.itemName is string && d.itemName.size() > 0 && d.itemName.size() <= 200
        && d.category == 'F&B'
        && d.fnbCategory is string && d.fnbCategory.size() <= 100
        && d.unit is string && d.unit.size() > 0 && d.unit.size() <= 30
        && d.quantity is number && d.quantity > 0
        && d.rate is number && d.rate >= 0
        && d.gstPercent == 0
        && d.taxableAmount is number && d.taxableAmount >= 0
        && d.gstAmount == 0
        && d.total is number && d.total >= 0
        && d.supplier is string && d.supplier.size() <= 200
        && d.invoiceNumber is string && d.invoiceNumber.size() <= 150
        && d.receiptDate is string && d.receiptDate.size() == 10
        && d.notes is string && d.notes.size() <= 1000
        && d.fnbOrderId is string && d.fnbOrderId.size() > 0
        && d.fnbReceiptId is string && d.fnbReceiptId.size() > 0
        && d.createdAt == request.time
        && existsAfter(receiptPath)
        && getAfter(receiptPath).data.inwardId == id
        && getAfter(receiptPath).data.orderId == d.fnbOrderId
        && getAfter(receiptPath).data.itemId == d.itemId
        && getAfter(receiptPath).data.quantity == d.quantity
        && getAfter(receiptPath).data.rate == d.rate;
    }

    function validFnbReceiptCreate(id) {
      let d = request.resource.data;
      let orderPath = /databases/$(database)/documents/fnb_orders/$(d.orderId);
      return d.keys().hasOnly([
          'orderId', 'itemId', 'itemName', 'category', 'supplier', 'unit', 'quantity',
          'rate', 'receiptDate', 'createdAt', 'transactionType', 'inwardId'
        ])
        && d.keys().hasAll([
          'orderId', 'itemId', 'itemName', 'category', 'supplier', 'unit', 'quantity',
          'rate', 'receiptDate', 'createdAt', 'transactionType', 'inwardId'
        ])
        && d.orderId is string && d.orderId.size() > 0
        && d.itemId is string && d.itemId.size() > 0
        && d.itemName is string && d.itemName.size() > 0 && d.itemName.size() <= 200
        && d.category is string && d.category.size() <= 100
        && d.supplier is string && d.supplier.size() <= 200
        && d.unit is string && d.unit.size() > 0 && d.unit.size() <= 30
        && d.quantity is number && d.quantity > 0
        && d.rate is number && d.rate >= 0
        && d.receiptDate is string && d.receiptDate.size() == 10
        && d.createdAt == request.time
        && d.transactionType == 'FNB_RECEIPT'
        && d.inwardId is string && d.inwardId.size() > 0
        && exists(orderPath)
        && getAfter(orderPath).data.lastReceiptId == id
        && getAfter(orderPath).data.receivedQty is number
        && get(orderPath).data.receivedQty is number
        && getAfter(orderPath).data.receivedQty - get(orderPath).data.receivedQty > d.quantity - 0.000001
        && getAfter(orderPath).data.receivedQty - get(orderPath).data.receivedQty < d.quantity + 0.000001
        && getAfter(orderPath).data.receivedQty <= getAfter(orderPath).data.orderedQty;
    }

    match /app_roles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      // Safe one-time owner bootstrap: verified Firebase identity, exact allowlisted email,
      // own UID only, and admin role only. It cannot overwrite an existing role.
      allow create: if (
          admin()
          || (signedIn()
            && request.auth.uid == uid
            && request.auth.uid == 'C1l8ArB3GlSaAQr6iw4O9RKGGik1'
            && request.resource.data.keys().hasOnly(['role', 'active', 'updatedAt', 'updatedBy', 'displayName'])
            && request.resource.data.role == 'admin'
            && request.resource.data.active == true)
          || (signedIn()
            && request.auth.uid == uid
            && request.auth.token.email == 'darkx@darkverse.go'
            && request.auth.token.email_verified == true
            && request.resource.data.keys().hasOnly(['role', 'active', 'updatedAt', 'updatedBy', 'displayName'])
            && request.resource.data.role == 'admin'
            && request.resource.data.active == true)
        )
        && request.resource.data.keys().hasOnly(['role', 'active', 'updatedAt', 'updatedBy', 'displayName'])
        && request.resource.data.role in ['admin', 'manager', 'storekeeper', 'operator']
        && request.resource.data.active is bool;
      allow update: if admin()
        && request.resource.data.keys().hasOnly(['role', 'active', 'updatedAt', 'updatedBy', 'displayName'])
        && request.resource.data.role in ['admin', 'manager', 'storekeeper', 'operator']
        && request.resource.data.active is bool;
      allow delete: if admin();
    }
    match /users/{id} {
      allow read: if manager();
      allow create, update, delete: if manager();
    }
    match /machines/{id} {
      allow read: if opsTeam();
      allow write: if manager();
    }
    match /fuel_logs/{id} {
      allow read, create, update: if storeTeam();
      allow delete: if manager();
    }
    match /shifts/{id} {
      allow read, create: if opsTeam();
      allow update, delete: if manager();
    }
    match /CourseZones/{id} {
      allow read: if opsTeam();
      allow write: if manager();
    }
    match /live_telemetry/{id} {
      allow read: if opsTeam();
      allow write: if opsTeam();
    }
    match /inventory/{id} {
      allow read: if signedIn() && hasRole(['admin', 'manager', 'storekeeper', 'operator']);
      allow create, delete: if storeTeam();
      allow update: if storeTeam()
        || (hasRole(['operator'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQuantity', 'updatedAt'])
          && request.resource.data.stockQuantity is number
          && request.resource.data.stockQuantity >= 0
          && request.resource.data.stockQuantity <= resource.data.stockQuantity);
    }
    match /logs/{id} {
      allow read: if opsTeam();
      allow create: if opsTeam();
      allow update, delete: if manager();
    }
    match /maintenance_logs/{id} {
      allow read: if opsTeam();
      allow write: if manager();
    }
    match /assignment_logs/{id} {
      allow read: if opsTeam();
      allow write: if manager();
    }
    match /turf_plans/{id} {
      allow read: if opsTeam() || hasRole(['storekeeper']);
      allow create, update: if opsTeam() || hasRole(['storekeeper']);
      allow delete: if manager();
    }
    match /store_inwards/{id} {
      allow read: if storeTeam();
      allow create: if storeTeam() && (validNormalInwardCreate() || validFnbInwardCreate(id));
      // F&B receipts are linked ledger records and cannot be altered/deleted independently.
      allow update: if storeTeam()
        && resource.data.transactionType != 'FNB_RECEIPT'
        && request.resource.data.transactionType != 'FNB_RECEIPT';
      allow delete: if storeTeam() && resource.data.transactionType != 'FNB_RECEIPT';
    }
    match /local_expenses/{id} {
      allow read: if storeTeam();
      allow create, update, delete: if manager();
    }
    match /fnb_orders/{id} {
      allow read: if fnbTeam();
      allow create: if fnbTeam() && validFnbOrderCreate();
      // Receipt updates may change only receipt balance, status, and server timestamp.
      allow update: if fnbTeam() && validFnbReceiptOrderUpdate(id);
      allow delete: if manager();
    }
    match /fnb_receipts/{id} {
      allow read: if fnbTeam();
      // A receipt must be paired with the matching order-balance increase in the same transaction.
      allow create: if fnbTeam() && validFnbReceiptCreate(id);
      // Receipt ledger records are immutable. Correct errors through a documented reversal flow.
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}